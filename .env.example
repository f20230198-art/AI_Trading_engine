# DOOM ENGINE — Environment Variables
# Copy this file to .env and fill in your keys.
#
# LLM BACKEND — resolved automatically in this priority order:
#   1. Ollama  (local, free, no limits) — just run `ollama serve` + `ollama pull mistral`
#   2. Groq    (free API, fast, 30rpm limit)
#   3. Gemini  (free API, fallback)
#   4. Anthropic (paid)
#   5. Quant   (pure algo fallback, no LLM at all — always works)
#
# You do NOT need to set every key — the engine picks the best available one.

# ── OPTION A: Local Ollama (recommended for showcase / no rate limits) ────────
# 1. Install Ollama: https://ollama.ai
# 2. Run: ollama pull mistral   (or llama3.2, phi3, etc.)
# 3. Ollama is auto-detected — no config needed. Or force it:
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral

# ── OPTION B: Groq free tier (fast cloud, rate-limited) ──────────────────────
# LLM_PROVIDER=groq
# GROQ_API_KEY_1=gsk_your-key-1-here
# GROQ_API_KEY_2=gsk_your-key-2-here   # optional extra key for rotation
# GROQ_API_KEY_3=gsk_your-key-3-here   # optional extra key

# ── OPTION C: Gemini free tier ────────────────────────────────────────────────
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIza-your-key-here
# GEMINI_API_KEY_2=AIza-your-key-2-here  # optional rotation
# LLM_MODEL=gemini-2.0-flash

# ── OPTION D: Anthropic ───────────────────────────────────────────────────────
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── OPTION E: Force pure quant (no LLM at all) ────────────────────────────────
# LLM_PROVIDER=quant

# ── Market Data (Alpaca paper trading) ───────────────────────────────────────
# Required for real price data and trade execution.
# Get free paper trading keys at https://alpaca.markets
ALPACA_API_KEY=PK-your-alpaca-key-here
ALPACA_SECRET_KEY=your-alpaca-secret-here

# ── Optional ──────────────────────────────────────────────────────────────────
LLM_MAX_TOKENS=1024
API_HOST=0.0.0.0
API_PORT=8000
# NEWS_API_KEY=your-newsapi-key-here  # enhances sentiment scanning
CYCLE_INTERVAL_SECONDS=120
